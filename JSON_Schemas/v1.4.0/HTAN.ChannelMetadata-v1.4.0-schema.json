{
  "$id": "https://w3id.org/htan/multiplex_microscopy/channel_metadata",
  "$schema": "https://json-schema.org/draft-07/schema",
  "additionalProperties": {},
  "description": "Metadata for each channel in multiplex microscopy imaging",
  "properties": {
    "ANTIBODY_NAME": {
      "description": "Short descriptive name for this antibody",
      "type": "string"
    },
    "CATALOG_NUMBER": {
      "description": "Catalog number from vendor",
      "type": "string"
    },
    "CHANNEL_ID": {
      "description": "The unique channel identifier for each channel in this image must match the corresponding field in the imaging file submitted",
      "type": "string"
    },
    "CHANNEL_NAME": {
      "description": "Channel label for each channel in this image must match the corresponding field in the imaging file submitted",
      "type": "string"
    },
    "CLONE": {
      "description": "Unique clone identifier",
      "type": "string"
    },
    "CONCENTRATION": {
      "description": "Final concentration used in experiment",
      "type": "string"
    },
    "CYCLE_NUMBER": {
      "description": "The cycle",
      "type": "integer"
    },
    "DILUTION": {
      "description": "Final dilution ratio used in experiment",
      "type": "string"
    },
    "EMISSION_BANDWIDTH": {
      "description": "Nominal width of emission spectrum (nm)",
      "type": "number"
    },
    "EMISSION_WAVELENGTH": {
      "description": "Center/peak of the emission spectrum (nm)",
      "type": "number"
    },
    "EXCITATION_BANDWIDTH": {
      "description": "Nominal width of excitation spectrum (nm)",
      "type": "number"
    },
    "EXCITATION_WAVELENGTH": {
      "description": "Center/peak of the excitation spectrum (nm)",
      "type": "number"
    },
    "FLUOROPHORE": {
      "description": "Fluorescent dye label",
      "type": "string"
    },
    "LOT": {
      "description": "Lot number from vendor",
      "type": "string"
    },
    "METAL_ISOTOPE_ELEMENT_ABBREVIATION": {
