      "title": "MetalIsotopeElement",
      "type": "string"
    },
    "METAL_ISOTOPE_ELEMENT_MASS": {
      "description": "Element mass number",
      "type": "integer"
    },
    "OLIGO_BARCODE_LOWER_STRAND": {
      "description": "DNA barcode used for labeling",
      "type": "string"
    },
    "OLIGO_BARCODE_UPPER_STRAND": {
      "description": "DNA barcode used for labeling",
      "type": "string"
    },
    "RRID_IDENTIFIER": {
      "description": "Research Resource Identifier",
      "pattern": "^RRID:AB_\\d+$",
      "type": "string"
    },
    "SUB_CYCLE_NUMBER": {
      "description": "Sub-cycle",
      "type": "integer"
    },
    "TARGET_NAME": {
      "description": "Short descriptive name (abbreviation) for this target (antigen)",
      "type": "string"
    }
  },
  "required": [
    "CHANNEL_ID",
    "CHANNEL_NAME"
  ],
  "title": "MultiplexMicroscopyChannelMetadata",
  "type": "object"
}